# Supabase (avisos, painel de senhas, login do painel)
SUPABASE_URL=
SUPABASE_KEY=

# Google Places API (horário de funcionamento e avaliações) — só no servidor
NUXT_GOOGLE_PLACES_KEY=

# Sympla — token gerado em Minha Conta > Integrações — só no servidor
NUXT_SYMPLA_TOKEN=

# PostHog (analytics) — chave pública do projeto
NUXT_PUBLIC_POSTHOG_KEY=

# URL canônica do site (usada em sitemap, canonical e Open Graph)
NUXT_PUBLIC_SITE_URL=https://expedientebar.com.br
